#!/bin/bash

tput setaf 7 ; tput setab 4 ; tput bold
printf '%20s%s\n' "   එකවර සම්බන්ධතා වල සීමාව වෙනස් කරන්න   "
tput sgr0

database="/root/usuarios.db"
if [ ! -f "$database" ]; then
    tput setaf 7 ; tput setab 1 ; tput bold
    echo ""
    echo "සංරක්ෂිතය $database සොයා ගත නොහැක"
    echo ""
    tput sgr0
    exit 1
fi

tput setaf 3 ; tput bold
echo ""
echo "පරිශීලකයින්ගේ ලැයිස්තුව සහ ඔවුන්ගේ සීමාවන්:"
tput sgr0
echo ""

# Get list of users (UID >= 1000), not nobody
_userT=$(awk -F: '$3>=1000 {print $1}' /etc/passwd | grep -v nobody)

# Build number mapping and user limit mapping
declare -A user_number_map
declare -A user_limit_map
declare -a original_order
declare -a sorted_display

i=0
_userPass=""
while read -r _user; do
    i=$((i + 1))
    [[ $i -lt 10 ]] && num="0$i" || num="$i"
    user_number_map["$_user"]="$num"
    original_order+=("$_user")
    
    if grep -qw "$_user" "$database"; then
        limit=$(grep -w "$_user" "$database" | cut -d' ' -f2)
    else
        limit="1"
    fi
    user_limit_map["$_user"]="$limit"
done <<< "$_userT"

# Sort usernames alphabetically for display
sorted_display=($(printf "%s\n" "${original_order[@]}" | sort))

# Display users (alphabetically), keep original numbering
for user in "${sorted_display[@]}"; do
    num="${user_number_map[$user]}"
    limit="${user_limit_map[$user]}"
    l_user=$(echo -e "\033[1;31m[\033[1;36m$num\033[1;31m] \033[1;37m- \033[1;32m$user\033[0m")
    lim=$(echo -e "\033[1;33mLimite\033[1;37m: $limit")
    printf '%-65s%s\n' "$l_user" "$lim"
    _userPass+="\n$num:$user"
done

echo ""
num_user="${#original_order[@]}"
echo -ne "\033[1;32mපරිශීලකයෙකු ටයිප් කරන්න හෝ තෝරන්න\033[1;33m[\033[1;36m1\033[1;31m-\033[1;36m$num_user\033[1;33m]\033[1;37m: "
read -r option

usuario=$(echo -e "$_userPass" | grep -E "^$option:" | cut -d: -f2)

if [[ -z $option || -z $usuario ]]; then
    tput setaf 7 ; tput setab 1 ; tput bold
    echo ""
    echo "හිස් හෝ නොපවතින පරිශීලකයෙක්"
    echo ""
    tput sgr0
    exit 1
fi

if getent passwd "$usuario" > /dev/null; then
    echo -ne "\n\033[1;32mනව පරිශීලක සීමාව \033[1;33m$usuario\033[1;37m: "
    read -r sshnum

    if [[ -z $sshnum || $sshnum =~ [^0-9] || $sshnum -lt 1 ]]; then
        tput setaf 7 ; tput setab 1 ; tput bold
        echo ""
        echo "ඔබ අවලංගු අංකයක් ඇතුළත් කර ඇත!"
        echo ""
        tput sgr0
        exit 1
    fi

    grep -v "^$usuario[[:space:]]" "$database" > /tmp/a
    mv /tmp/a "$database"
    echo "$usuario $sshnum" >> "$database"

    tput setaf 7 ; tput setab 4 ; tput bold
    echo ""
    echo "සීමාව පරිශීලකයාට අදාළ වේ $usuario foi $sshnum "
    tput sgr0
    sleep 2
    exit 0
else
    tput setaf 7 ; tput setab 1 ; tput bold
    echo ""
    echo "පරිශීලකයා $usuario සොයාගත නොහැක"
    echo ""
    tput sgr0
    exit 1
fi
